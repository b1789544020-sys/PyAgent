# Local Ollama configuration; no API key is required for this backend.
AGENT_LLM=ollama
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_MODEL=qwen2.5:3b-cpu
AGENT_OLLAMA_URL=http://127.0.0.1:11434
AGENT_EMBED_MODEL=embeddinggemma:300m-qat-q4_0
AGENT_DATA_DIR=.pyagent-data
AGENT_TOP_K=4
AGENT_MODEL_TIMEOUT=180
